<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Suite" thread-count="5" parallel ="tests">  <!-- parallel testing and cross brower testing-->

  <test name="chromeTest">						     	<!-- xml file are at project level-->		
    <parameter name ="os"  value ="Windwos" />
    <parameter name ="browser"  value ="chrome" />
    
    <classes>
      <class name="testCases.AccountRegistrationTest"/>
    </classes>
  </test> <!-- Test -->
  
    <test name="edgeTest">
    <parameter name ="os"  value ="Windwos" />
    <parameter name ="browser"  value ="edge" />
    
    <classes>
      <class name="testCases.AccountRegistrationTest"/>
    </classes>
  </test> <!-- Test -->
  
  
</suite> <!-- Suite -->
